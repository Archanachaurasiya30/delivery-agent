# Database
DATABASE_URL=postgresql+asyncpg://delivery:delivery@localhost:5433/delivery_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
LLM_PROVIDER=litellm
LLM_MODEL=gpt-4

# Demo mode: replay pre-recorded agent proposals/standups/briefs/answers
# instead of calling an LLM — the full UI + live agent loop runs with ZERO
# API keys (issue #2).
DEMO_MODE=false

# API Keys (replace with your actual keys)
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-xxx
AZURE_API_KEY=xxx
AZURE_API_BASE=https://xxx.openai.azure.com

# Security
SECRET_KEY=change-me-in-production

# Optional passcode gate for exposed deployments (issue #8). Empty = open
# (LAN default). When set: browsers unlock at /api/v1/passcode once; CLI
# callers send the same value as an X-Passcode header.
PASSCODE=

# Task provider: mock (demo default) | tfs | github | dump (offline TFS capture)
INTEGRATION_PROVIDER=mock
# When false, the provider refuses all writes (safety dial for real instances)
PUSH_ENABLED=true

# GitHub Issues provider (INTEGRATION_PROVIDER=github)
GITHUB_REPO=owner/name
GITHUB_TOKEN=ghp_xxx

# Azure DevOps / TFS provider (INTEGRATION_PROVIDER=tfs)
TFS_URL=https://dev.azure.com/your-org
TFS_PAT=
TFS_PROJECT=

# Debug mode
DEBUG=true
